{
  "_comment": "Proxy for blocked services only. Copy to data/xray/config.json (chmod 600) and put the parameters of your foreign server into the 'abroad' outbound (on TrueNAS: the same as the vps-1 outbound in 3x-ui). Only the domains listed in routing go abroad; anything else sent here is refused.",
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": false },
      "sniffing": { "enabled": true, "destOverride": ["http", "tls"] }
    }
  ],
  "outbounds": [
    {
      "tag": "abroad",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "VPS_ADDRESS",
            "port": 443,
            "users": [{ "id": "UUID", "encryption": "none", "flow": "xtls-rprx-vision" }]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "SNI",
          "fingerprint": "chrome",
          "publicKey": "PUBLIC_KEY",
          "shortId": "SHORT_ID"
        }
      }
    },
    { "tag": "refuse", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["socks"],
        "domain": [
          "domain:telegram.org",
          "domain:t.me",
          "domain:themoviedb.org",
          "domain:tmdb.org"
        ],
        "outboundTag": "abroad"
      },
      { "type": "field", "inboundTag": ["socks"], "outboundTag": "refuse" }
    ]
  }
}
