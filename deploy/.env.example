# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Public address of the site (Traefik routes it to kino-server).
KINO_HOST=kino.aat-terra.ru
PUBLIC_URL=https://kino.aat-terra.ru

# Names from your traefik.yml: the HTTPS entrypoint and the certificate resolver.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Database password (any long random string).
POSTGRES_PASSWORD=

# From @BotFather. Also set the bot's domain there (/setdomain) to KINO_HOST for the Login Widget.
BOT_TOKEN=
BOT_USERNAME=

# Long random string, at least 32 characters (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Your Telegram user id(s); they become admins and can create invites.
ADMIN_TELEGRAM_IDS=

# Film and series metadata: free API key from https://www.themoviedb.org/settings/api
# ("API Key" or "API Read Access Token" both work). Without it the site shows a small demo catalog.
TMDB_API_KEY=
# TMDB_LANGUAGE=ru-RU

# Torrents. Without Jackett the release list shows demo data; without TorrServer
# nothing plays; without qBittorrent there is no "Скачать заранее".
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=
# The TorrServer that already runs on the server, with its login.
TORRSERVER_URL=http://host.docker.internal:5665
TORRSERVER_USER=
TORRSERVER_PASSWORD=
QBITTORRENT_URL=http://qbittorrent:8090
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=
# The download folder as qBittorrent sees it, and as kino-server sees it.
QBITTORRENT_SAVE_PATH=/downloads
PRELOAD_DIR=/downloads
# Host folder for downloads (HDD pool) and the owner of the files.
# DOWNLOADS_DIR=/mnt/HDD_Data/kino/downloads
# PUID=568
# PGID=568
# Video re-encoding on the Intel GPU: vaapi, qsv or none (CPU).
TRANSCODE_HWACCEL=vaapi
# Group id of /dev/dri/renderD128 on the host (`stat -c %g /dev/dri/renderD128`).
# RENDER_GID=107

# Optional
# SESSION_TTL_DAYS=90
# How often the bot checks for new episodes (hours), and how long preloads are kept after watching (days).
# NOTIFY_INTERVAL_HOURS=6
# PRELOAD_KEEP_DAYS=7
# RUST_LOG=info
