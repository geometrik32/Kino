# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Public address of the site (Traefik routes it to kino-server).
KINO_HOST=kino.aat-terra.ru
PUBLIC_URL=https://kino.aat-terra.ru

# Names from your traefik.yml: the HTTPS entrypoint and the certificate resolver.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le-resolver

# Database password (any long random string).
POSTGRES_PASSWORD=

# From @BotFather. Also set the bot's domain there (/setdomain) to KINO_HOST for the Login Widget.
BOT_TOKEN=
BOT_USERNAME=

# Long random string, at least 32 characters (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Your Telegram user id(s); they become admins and can create invites.
ADMIN_TELEGRAM_IDS=

# Film and series metadata: free API key from https://www.themoviedb.org/settings/api
# ("API Key" or "API Read Access Token" both work). Without it the site shows a small demo catalog.
TMDB_API_KEY=
# TMDB_LANGUAGE=ru-RU

# Torrents. Without Jackett (or EXTRA_TORZNAB_URLS) the release list shows demo data;
# without TorrServer nothing plays; without qBittorrent there is no "Скачать заранее".
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=
# Optional extra Torznab search endpoints queried alongside Jackett (comma-separated,
# e.g. a public JacRed mirror; append `|API_KEY` if an endpoint requires a key).
# EXTRA_TORZNAB_URLS=https://jac-red.ru
# Our own TorrServer from this stack (not Lampa's). No login needed: it is not exposed.
TORRSERVER_URL=http://torrserver:8090
# TorrServer takes peers on port 32000 (tcp+udp); forward it on the router for better speed.
QBITTORRENT_URL=http://qbittorrent:8085
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=
# The download folder as qBittorrent sees it, and as kino-server sees it.
QBITTORRENT_SAVE_PATH=/downloads
PRELOAD_DIR=/downloads
# Host folder for downloads (HDD pool) and the owner of the files.
# Host folder for downloads: the ZFS dataset HDD_Data/orel-kino.
# DOWNLOADS_DIR=/mnt/HDD_Data/orel-kino
# PUID=568
# PGID=568
# Video re-encoding on the Intel GPU: vaapi, qsv or none (CPU).
TRANSCODE_HWACCEL=vaapi
# Max simultaneous video transcodes (default 4 for up to 3 active users + pause headroom).
# MAX_TRANSCODES=4
# Group id of /dev/dri/renderD128 on the host (`stat -c %g /dev/dri/renderD128`).
# RENDER_GID=107
# Optional disk cache for TMDB posters/backdrops (MB, default 400).
# IMAGE_CACHE_DIR=/var/cache/kino-img
# IMAGE_CACHE_MAX_MB=400
# Optional SSD pause-resume cache for torrent streams (5 GiB, 72h TTL).
# PAUSE_CACHE_DIR=/var/cache/kino-pause
# PAUSE_CACHE_MAX_MB=5120
# PAUSE_CACHE_TTL_HOURS=72
# Optional on-demand sleep/wake for Jackett via Sablier.
# JACKETT_WAKE_URL=http://sablier:10000
# JACKETT_WAKE_GROUP=jackett
# JACKETT_WAKE_DURATION=10m

# Optional
# SESSION_TTL_DAYS=90
# How often the bot checks for new episodes (hours), and how long preloads are kept after watching (days).
# NOTIFY_INTERVAL_HOURS=6
# PRELOAD_KEEP_DAYS=7
# RUST_LOG=info

# Proxies for blocked services only; everything else goes directly.
# socks5h:// lets the proxy resolve names (the local DNS may lie about them).
# On TrueNAS: the SOCKS inbound of 3x-ui (container 3x-ui, network VPN_NETWORK).
# TELEGRAM_PROXY=socks5h://user:password@3x-ui:10808
# TMDB_PROXY=socks5h://user:password@3x-ui:10808
